---
import { site } from "../data/content";

const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-border px-5 py-12 sm:px-8 lg:px-12 dark:border-neon-cyan/20">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="neon-text-pink font-display text-lg font-semibold text-ink">
        {site.shortName}
      </p>
      <p class="mt-1 text-sm text-ink-muted">
        © {year} · Built with Astro, React & Tailwind
      </p>
    </div>
    <a
      href={site.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Connect on LinkedIn (opens in a new tab)"
      class="text-sm font-medium text-ink underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:hover:text-neon-cyan"
    >
      Connect on LinkedIn
    </a>
  </div>
</footer>
